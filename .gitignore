# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets de signature : le dépôt est public, aucune clé ne doit y entrer.
# android/.gitignore les couvre déjà pour Android ; on couvre la racine et iOS.
key.properties
*.keystore
*.jks
*.p12
*.mobileprovision
*.cer
*.pem

# Secrets d'exécution : identifiants du proxy, du client OAuth2, du fournisseur.
# Le dépôt est PUBLIC : un secret poussé une fois y reste, dans l'historique,
# même après suppression du fichier. Ces fichiers ne doivent donc jamais être
# suivis, et l'historique d'un dépôt public se considère comme définitif.
.env
.env.*
!.env.exemple
*.secret
secrets/

# Sauvegardes locales et journaux de commande.
.sauvegarde/
*.log

# État local de l'outil Flutter : il ne décrit pas le projet, seulement la
# machine sur laquelle la commande a tourné.
.flutter_tool_state

# --- Polices du Mushaf ----------------------------------------------------
#
# Ce n'est pas une question de poids, mais de licence. Les conditions de la
# Quran Foundation autorisent la mise en cache et l'embarquement des polices à
# deux réserves : disposer d'un compte Developer Console actif, et créditer
# « Quran fonts provided by Quran Foundation ». Elles précisent surtout que les
# fichiers « may be distributed only as an integrated part of your application »
# et « may not be offered separately through your own API, asset package,
# standalone download, or similar offering ».
#
# Un dépôt Git public contenant les 604 fichiers EST un « asset package » : il
# les redistribue séparément de l'application, à quiconque, sans compte ni
# crédit. Les ignorer n'est donc pas une précaution d'hygiène, c'est la
# condition qui rend l'embarquement licite. Les fichiers restent téléchargeables
# par le fournisseur, à l'adresse documentée (voir assets/mushaf/README.md) :
# rien n'est perdu, puisque le dépôt n'a jamais eu à les porter.
assets/mushaf/qcf2/*.ttf
assets/mushaf/uthmanic/*.ttf
